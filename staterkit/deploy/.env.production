# Flask
FLASK_CONFIG=production
SECRET_KEY=CHANGE_ME_GENERATE_WITH_python3_-c_"import_secrets;print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_ANOTHER_ONE

# Canonical public URL for links in outbound email. Must be set: without it
# links fall back to request.url_root, which is built from the Host header —
# a poisoned host would put an attacker's link inside a breach alert.
APP_BASE_URL=https://intel.dseclab.mn

# Database (PostgreSQL)
DATABASE_URL=postgresql://dseclab:CHANGE_ME_DB_PASSWORD@localhost:5432/dseclab

# Elasticsearch
ELASTICSEARCH_URL=https://localhost:9200
ELASTICSEARCH_PASSWORD=CHANGE_ME_ES_PASSWORD
ELASTICSEARCH_INDEX=main

# Cache (Redis optional)
CACHE_TYPE=simple
# CACHE_TYPE=redis
# CACHE_REDIS_URL=redis://localhost:6379/0

# Rate limiting
RATELIMIT_STORAGE_URI=memory://

# Email — Resend SMTP relay. MAIL_PASSWORD is the Resend API key, and the
# sender must sit on a domain verified in Resend (notification.dseclab.mn).
MAIL_SERVER=smtp.resend.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=resend
MAIL_PASSWORD=CHANGE_ME_RESEND_API_KEY
MAIL_DEFAULT_SENDER=report@notification.dseclab.mn

# Features
ALLOW_SELF_REGISTRATION=false
