# Flask
FLASK_CONFIG=production
SECRET_KEY=CHANGE_ME_GENERATE_WITH_python3_-c_"import_secrets;print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_ANOTHER_ONE

# Database (PostgreSQL)
DATABASE_URL=postgresql://dseclab:CHANGE_ME_DB_PASSWORD@localhost:5432/dseclab

# Elasticsearch
ELASTICSEARCH_URL=https://localhost:9200
ELASTICSEARCH_PASSWORD=CHANGE_ME_ES_PASSWORD
ELASTICSEARCH_INDEX=main

# Cache (Redis optional)
CACHE_TYPE=simple
# CACHE_TYPE=redis
# CACHE_REDIS_URL=redis://localhost:6379/0

# Rate limiting
RATELIMIT_STORAGE_URI=memory://

# Email (optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@dseclab.com

# Features
ALLOW_SELF_REGISTRATION=false
